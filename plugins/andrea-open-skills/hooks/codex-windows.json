{
  "description": "Check changed JS, TS, PHP, Rust, and Python and advise Codex after edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|apply_patch",
        "hooks": [
          {
            "command": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\skills\\complexity-cli\\scripts\\check_complexity.py\" --hook",
            "statusMessage": "Checking code complexity",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\skills\\complexity-cli\\scripts\\check_complexity.py\" --baseline-hook",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
